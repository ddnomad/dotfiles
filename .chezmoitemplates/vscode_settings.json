{
	"breadcrumbs.enabled": false,

	"chat.disableAIFeatures": true,
	"chat.titleBar.openInAgentsWindow.enabled": false,

	"diffEditor.ignoreTrimWhitespace": false,
	"diffEditor.renderSideBySide": false,

	"editor.bracketPairColorization.enabled": false,
	"editor.cursorStyle": "underline",
	"editor.fontFamily": "Hack Nerd Font Mono",
	"editor.fontSize": 12,
	"editor.guides.bracketPairs": false,
	"editor.inlayHints.enabled": "offUnlessPressed",
	"editor.lineNumbers": "relative",
	"editor.minimap.enabled": false,
	"editor.renderWhitespace": "boundary",
	"editor.rulers": [
		150
	],
	"editor.scrollBeyondLastLine": false,
	"editor.wordWrap": "on",

	"files.autoSave": "afterDelay",
	"fold.level": 3,
	"git.autofetch": true,

	"gitlab.duo.enabledWithoutGitlabProject": false,
	"gitlab.duoAgentPlatform.enabled": false,
	"gitlab.duoChat.enabled": false,
	"gitlab.duoCodeSuggestions.enabled": false,
	"gitlab.duoCodeSuggestions.openTabsContext": false,
	"gitlab.keybindingHints.enabled": false,

	"intellij.dataSharing": "none",
	"intellij.region": "europe",

	"python.analysis.typeCheckingMode": "strict",

	"terminal.integrated.initialHint": false,
	"terminal.integrated.cursorStyle": "underline",

	"vim.cursorStylePerMode.insert": "underline",
	"vim.cursorStylePerMode.normal": "underline",
	"vim.cursorStylePerMode.replace": "underline",
	"vim.cursorStylePerMode.visual": "underline",
	"vim.cursorStylePerMode.visualblock": "underline",
	"vim.cursorStylePerMode.visualline": "underline",
	"vim.incsearch": true,
	"vim.useSystemClipboard": true,

	"workbench.activityBar.compact": true,
	"workbench.activityBar.location": "top",
	"workbench.colorTheme": "Base16 Default Dark",
	"workbench.experimental.modernUI": false,
	"workbench.iconTheme": "file-icons",
	"workbench.tree.renderIndentGuides": "onHover",

	"yaml.disableSchemaDetection": [
		"**/.github/workflows/*.yml",
		"**/.github/workflows/*.yaml",
		"**/.gitea/workflows/*.yml",
		"**/.gitea/workflows/*.yaml",
		"**/.forgejo/workflows/*.yml",
		"**/.forgejo/workflows/*.yaml"
	]
}